void setup() {
  Serial.begin(115200);
  irsend.begin();
  pinMode(LED_BUILTIN, OUTPUT);
  dht.begin(); // 初始化 DHT22

  // 連接 WiFi
  WiFi.begin(ssid, password);
  Serial.print("連線中");
  while (WiFi.status() != WL_CONNECTED) {
    delay(1000);
    Serial.print(".");
  }
  Serial.println("\nWiFi 已連線！");
  
  // 連線成功閃三下提示
  at_section(3); 
}

void loop() {
  // 讀取 DHT22 溫度（讀取失敗時沿用上一次成功的數值，避免傳送 NaN）
  float temperature = dht.readTemperature();
  float humidity = dht.readHumidity(); // 濕度僅用於測試階段輸出確認，暫不上傳
  if (isnan(temperature)) {
    Serial.println("DHT22 讀取失敗，沿用上次數值");
    temperature = lastTemperature;
  } else {
    lastTemperature = temperature;
  }

  // --- 測試用：將 DHT22 讀值直接輸出至序列埠(Serial Monitor)，方便確認感測器是否正常 ---
  Serial.print("[DHT22] 溫度: ");
  if (isnan(temperature)) {
    Serial.print("讀取失敗");
  } else {
    Serial.print(temperature, 1);
    Serial.print(" C");
  }
  Serial.print("  濕度: ");
  if (isnan(humidity)) {
    Serial.println("讀取失敗");
  } else {
    Serial.print(humidity, 1);
    Serial.println(" %");
  }

  if (WiFi.status() == WL_CONNECTED) {
    HTTPClient http;

    // 將溫度以 URL 參數附加送出（讀取失敗時不附加）
    String requestUrl = apiUrl;
    if (!isnan(temperature)) {
      requestUrl += "&temp=" + String(temperature, 1);
    }
    http.begin(requestUrl);

    // 收集 Date 標頭以取得伺服器時間
    const char* headerKeys[] = {"Date"};
    http.collectHeaders(headerKeys, 1);

    int httpCode = http.GET();

    if (httpCode > 0) {
      // 取得伺服器時間並存入變數
      if (http.hasHeader("Date")) {
        // HTTP Date 格式: "Wed, 02 Jul 2026 10:03:41 GMT"
        // 只保留時間段，索引 17~24，共 8 碼
        serverTime = http.header("Date").substring(17, 25);
        Serial.println("伺服器時間: " + serverTime);
      }

      String payload = http.getString();

      // 解析 JSON
      StaticJsonDocument<200> doc;
      DeserializationError error = deserializeJson(doc, payload);

      if (!error) {
        String cmd = doc["command"]; // 取得 API 中的指令字串
        bool done = doc["done"];     // 取得指令是否已執行完畢

        // 'reset' 代表無待執行指令，直接略過
        if (cmd == "reset") {
          http.end();
          delay(3000);
          return;
        }

        // done 為 true 代表指令已執行完畢，略過不重複執行
        if (done) {
          http.end();
          delay(3000);
          return;
        }

        at_section(3); // 發送訊號閃三下提示

        executeCommand(cmd);     // 跳轉到判斷邏輯
        resetStatus(); // 執行完畢後，通知伺服器重置指令，避免重複執行

      }
    }
    http.end();
  }
  
  delay(3000); // 每 3 秒檢查一次伺服器
}

// --- 3. 判斷指令與發送 (Switch Case 邏輯) ---
void executeCommand(String cmd) {
  // 將字串轉為整數編號，因為 switch 不支援字串 
  if (cmd == "POWER_ON_23") {
    Serial.println("執行：開機 23度");
    irsend.sendRaw(on23, 139, 38);
    } 
  else if (cmd == "TEMP_25") {
    Serial.println("執行：設定 25度");
    irsend.sendRaw(at25o, 139, 38);
  }
  else if (cmd == "TEMP_26") {
    Serial.println("執行：設定 26度");
    irsend.sendRaw(at26o, 139, 38);
  } 
  else if (cmd == "TEMP_27") {
    Serial.println("執行：設定 27度");
    irsend.sendRaw(at27o, 139, 38);
  } 
  else if (cmd == "OFF_0H5") {
    Serial.println("執行：送風0.5小時後關機");
    irsend.sendRaw(fn2fan, 139, 38);
    delay(5000);
    irsend.sendRaw(at005hr2Off, 279, 38);
  } 
  else if (cmd == "OFF_4H5") {
    Serial.println("執行：送風4.5小時後關機");
    irsend.sendRaw(fn2fan, 139, 38);
    delay(5000);
    irsend.sendRaw(at405hr2Off, 279, 38);
  } 
  else if (cmd == "reset") {
    return; // 無待執行指令，略過
  }
  else {
    Serial.println("未知指令: " + cmd);
  }
}

void timing(String cmd) {

  // 解析 JSON
  StaticJsonDocument<200> doc;
  DeserializationError error = deserializeJson(doc, cmd);

  if (!error) {
