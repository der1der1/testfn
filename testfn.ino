// 執行完紅外線訊號後，通知伺服器將指令重置為 'reset'
void resetStatus() {
  if (WiFi.status() == WL_CONNECTED) {
    HTTPClient http;
    http.begin(apiUrlReset);
    int httpCode = http.GET();
    if (httpCode > 0) {
      String payload = http.getString();
      Serial.println("重置回應: " + payload);
    } else {
      Serial.println("重置失敗，HTTP 錯誤: " + String(httpCode));
    }
    http.end();
  }
}

// 檢查區塊用的 LED 閃爍函數
void at_section(int i) {
  for (int j = 0; j < i; j++) {
    digitalWrite(LED_BUILTIN, HIGH);
    delay(200);
    digitalWrite(LED_BUILTIN, LOW);
    delay(200);
  }
}
